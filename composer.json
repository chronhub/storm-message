{
    "name": "chronhub/storm-message",
    "description": "Storm Message — the neutral, transport-free envelope pairing a domain message with typed headers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "message"],
    "require": {
        "php": ">=8.5",
        "chronhub/storm-clock": "self.version",
        "chronhub/storm-contracts": "self.version",
        "symfony/dependency-injection": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0",
        "symfony/process": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Message\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Message\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
